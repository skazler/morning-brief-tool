# ─────────────────────────────────────────────────────────────────────────────
# MORNING BRIEFING — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Recipient ─────────────────────────────────────────────────────────────────
RECIPIENT_NAME=
RECIPIENT_EMAIL=

# ── Email delivery ────────────────────────────────────────────────────────────
# Choose: smtp | sendgrid
EMAIL_PROVIDER=smtp
FROM_NAME=Morning Briefing
FROM_EMAIL=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Gmail: use an App Password, not your account password
# Get one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SendGrid ──────────────────────────────────────────────────────────────────
# Only needed if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# ── Weather ───────────────────────────────────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# City name or lat,lon e.g. "30.2672,-97.7431"
WEATHER_LOCATION=
# imperial (°F, mph) or metric (°C, m/s)
WEATHER_UNITS=imperial

# ── News ──────────────────────────────────────────────────────────────────────
# Get a free key at: https://newsapi.org/register
NEWS_API_KEY=
