# ─────────────────────────────────────────────────────────────────────────────
# MORNING BRIEFING — SECRETS
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env, fill in, then push to the Worker:
#
#     ./scripts/push-secrets.sh
#
# In production the Worker never reads this file — it reads Cloudflare secrets.
# Copy it to .dev.vars (same format) if you want `wrangler dev` to pick them up
# locally. Hacker News requires no API key.
#
# Non-secret settings — schedule, timezone, units, sender name — live in
# wrangler.jsonc `vars`. Content settings live in src/config.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Recipient ─────────────────────────────────────────────────────────────────
RECIPIENT_NAME=
RECIPIENT_EMAIL=

# ── Email delivery ────────────────────────────────────────────────────────────
# Get your Resend API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ── Weather ───────────────────────────────────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# City name or lat,lon e.g. "30.2672,-97.7431"
WEATHER_LOCATION=

# ── The Guardian ──────────────────────────────────────────────────────────────
# Get a free key at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# ── Discord (optional) ────────────────────────────────────────────────────────
# Channel webhook: Edit Channel → Integrations → Webhooks → New → Copy URL.
# Set it and the briefing is posted to that channel as well as emailed; leave it
# blank and Discord delivery stays off. Email can be dropped entirely by
# clearing RESEND_API_KEY / RECIPIENT_EMAIL above.
DISCORD_WEBHOOK_URL=
