# ─────────────────────────────────────────────────────────────────────────────
# MORNING BRIEFING — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Hacker News requires no API key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Recipient ─────────────────────────────────────────────────────────────────
RECIPIENT_NAME=
RECIPIENT_EMAIL=

# ── Email delivery ────────────────────────────────────────────────────────────
# Get your Resend API key at https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ── Weather ───────────────────────────────────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# City name or lat,lon e.g. "30.2672,-97.7431"
WEATHER_LOCATION=
# imperial (°F, mph) or metric (°C, m/s)
WEATHER_UNITS=imperial

# ── The Guardian ──────────────────────────────────────────────────────────────
# Get a free key at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
